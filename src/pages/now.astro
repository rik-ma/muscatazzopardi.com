    letter-spacing: -0.035em;
    line-height: 0.94;
    margin: 0 0 1.75rem 0;
    color: var(--fg);
  }
  .dateline {
    font-family: 'JetBrains Mono', monospace;
    font-size: 13px;
    color: var(--fgSoft);
    margin: 0;
  }
  .now-body {
    padding-bottom: clamp(4rem, 10vh, 7rem);
  }
  .now-body strong {
    font-weight: 600;
  }
</style>
