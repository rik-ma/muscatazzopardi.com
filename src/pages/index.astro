---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const allWriting = await getCollection('writing', ({ data }) => !data.draft);
const writing = allWriting.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const featuredIndex = writing.findIndex((entry) => entry.id === 'commodities');
const featured = featuredIndex >= 0 ? writing[featuredIndex] : null;
const rest = featuredIndex >= 0 ? writing.filter((_, i) => i !== featuredIndex) : writing;

const dateFormatter = new Intl.DateTimeFormat('en', { month: 'short', year: 'numeric' });
const isoMonth = (d: Date) => d.toISOString().slice(0, 7);
---

<BaseLayout
  title="Richard Muscat Azzopardi"
  description="CEO of Switch, Vistage Chair, and fractional CMO to a small number of US and UK companies. I help specialised B2B businesses, mostly in manufacturing and technology, stop being chosen on price. Growth and kindness are not a trade-off."
>
  <main id="main">
    <section class="thesis-hero fade-up fade-up-1">
      <p class="thesis-line">Growth and <span class="accent">kindness</span> are not a trade-off.</p>
      <h1 class="byline">Richard Muscat Azzopardi</h1>
      <p class="byline-role">Decommoditisation and growth for specialised B2B businesses</p>
    </section>

    <section class="intro fade-up fade-up-2">
      <div class="portrait-col">
        <figure class="portrait-figure">
          <img
            src="/images/portrait.jpg"
            width="1600"
            height="1067"
            alt="Richard Muscat Azzopardi"
            loading="eager"
          />
        </figure>
      </div>
      <div class="prose-col">
        <p class="intro-lead">Hi, I&rsquo;m Rik.</p>
        <div class="prose">
          <p>I&rsquo;ve spent the last twenty years building businesses and helping other people build theirs. Most of that help now goes one way: getting specialised B2B companies out of the trap of being chosen on price. The word I use for it is decommoditisation, and I do most of it in manufacturing and technology. In practice it&rsquo;s three jobs: I&rsquo;m the CEO of <a href="https://switch.com.mt">Switch</a>, a B2B brand and marketing consultancy I run with my brother Ed; I chair a <a href="https://vistage.com">Vistage</a> group of business leaders; and I work with a small number of US and UK companies as a strategy consultant and fractional CMO. Along the way I picked up an executive education at Stanford&rsquo;s Graduate School of Business, which still shapes how I think about strategy.</p>
          <p>The thread running through all of it is a simple belief: growth and kindness are not a trade-off. The best businesses I&rsquo;ve worked with grow <em>because</em> of how they treat their people and the world around them, not in spite of it. One of my goals in life is to prove that, repeatedly.</p>
          <p>Two things tend to keep clients around longer than any deliverable. I don&rsquo;t leave a problem until it moves, and I bring my address book with me: twenty years of building businesses has filled it with Vistage members and chairs, the independent agencies of ICOM&rsquo;s worldwide network, and the CFOs I coach across the US. Part of the job, as I see it, is knowing who to call.</p>
          <p>I write about marketing, strategy, and what it actually takes to run a good business over in <a href="/writing">Writing</a>. If you&rsquo;d like to get in touch, <a href="/contact">here&rsquo;s how</a>.</p>
        </div>
      </div>
    </section>

    {featured && (
      <section class="featured fade-up fade-up-3">
        <p class="featured-label">Start here</p>
        <a href={`/writing/${featured.id}`} class="writing-item">
          <span class="writing-title">{featured.data.title}</span>
        </a>
        <p class="featured-desc">{featured.data.description}</p>
        <time class="writing-meta" datetime={isoMonth(featured.data.date)}>
          {dateFormatter.format(featured.data.date)}
        </time>
      </section>
    )}

    <section class="writing fade-up fade-up-4">
      <h2 class="writing-label">Writing</h2>
      {rest.map((entry) => (
        <a href={`/writing/${entry.id}`} class="writing-item">
          <span class="writing-title">{entry.data.title}</span>
          <time class="writing-meta" datetime={isoMonth(entry.data.date)}>
            {dateFormatter.format(entry.data.date)}
          </time>
        </a>
      ))}
    </section>
  </main>

  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'Person',
    name: 'Richard Muscat Azzopardi',
    alternateName: 'Rik',
    jobTitle: 'CEO, Switch · Vistage Chair · Strategy consultant & fractional CMO',
    alumniOf: {
      '@type': 'CollegeOrUniversity',
      name: 'Stanford University Graduate School of Business',
    },
    worksFor: {
      '@type': 'Organization',
      name: 'Switch',
      url: 'https://switch.com.mt',
    },
    sameAs: [
      'https://www.linkedin.com/in/richardmuscatazzopardi',
      'https://switch.com.mt',
      'https://icomagencies.com',
    ],
  })} />
</BaseLayout>

<style>
  /* ---------- Hero: the thesis, signed ----------
     The entrypoint is the idea, not the name. The name is the page's H1
     (entity SEO) but set as a mono byline under the thesis — the cover
     grammar's "names are meta, meta is mono" author block. */
  .thesis-hero {
    padding-top: clamp(2rem, 6vh, 4.5rem);
    padding-bottom: clamp(3rem, 8vh, 5.5rem);
  }
  .thesis-line {
    font-family: 'Inter Tight', system-ui, sans-serif;
    font-weight: 600;
    font-size: clamp(3.4rem, 9vw, 7.5rem);
    letter-spacing: -0.04em;
    line-height: 0.95;
    margin: 0;
    max-width: 20ch;
    text-wrap: balance;
    color: var(--fg);
  }
  .thesis-line .accent { color: var(--acid); }
  h1.byline {
    font-family: 'JetBrains Mono', monospace;
    font-size: 15px;
    font-weight: 500;
    letter-spacing: 0.06em;
    color: var(--fg);
    margin: 2rem 0 0 0;
  }
  .byline-role {
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: 13px;
    font-weight: 400;
    letter-spacing: 0.06em;
    color: var(--fgSoft);
    margin: 0.6rem 0 0 0;
  }

  /* ---------- Intro: portrait + prose ---------- */
  .intro {
    padding-bottom: clamp(4rem, 10vh, 7rem);
    display: grid;
    grid-template-columns: minmax(0, 57fr) minmax(0, 43fr);
    grid-template-areas: "prose photo";
    gap: 0 clamp(2rem, 5vw, 5rem);
    align-items: start;
  }
  .portrait-col { grid-area: photo; min-width: 0; }
  .prose-col { grid-area: prose; min-width: 0; }
  .intro-lead {
    font-family: 'Inter Tight', system-ui, sans-serif;
    font-weight: 600;
    font-size: clamp(1.4rem, 2.5vw, 2rem);
    letter-spacing: -0.02em;
    line-height: 1.1;
    margin: 0 0 1.4rem 0;
    color: var(--fg);
  }

  /* ---------- Portrait: hard rectangle, bleeds to the right edge ---------- */
  .portrait-figure { margin: 0; }
  .portrait-figure img {
    display: block;
    width: calc(100% + clamp(1.25rem, 4vw, 4.5rem));
    height: auto;
  }

  @media (max-width: 760px) {
    .intro {
      grid-template-columns: 1fr;
      grid-template-areas:
        "photo"
        "prose";
    }
    .portrait-figure { margin-bottom: 2rem; }
    .portrait-figure img { width: calc(100% + clamp(1.25rem, 4vw, 4.5rem)); }
  }

  /* ---------- Featured: the commodities essay, pinned above the list ---------- */
  .featured {
    padding-bottom: clamp(3rem, 8vh, 5rem);
  }
  .featured-label {
    font-family: 'JetBrains Mono', monospace;
    font-size: 13px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--fgSoft);
    margin: 0 0 1.25rem 0;
  }
  .featured .writing-title { margin-bottom: 0.75rem; }
  .featured-desc {
    font-family: 'Inter Tight', system-ui, sans-serif;
    font-size: 1.0625rem;
    line-height: 1.5;
    color: var(--fgSoft);
    max-width: 55ch;
    margin: 0 0 1rem 0;
  }

  /* ---------- Writing: titles and whitespace, nothing else ---------- */
  .writing {
    padding-bottom: clamp(4rem, 10vh, 7rem);
  }
  .writing-label {
    font-family: 'Inter Tight', system-ui, sans-serif;
    font-weight: 600;
    font-size: 1.0625rem;
    color: var(--fgSoft);
    margin: 0 0 2.75rem 0;
  }
  .writing-item {
    display: block;
    text-decoration: none;
  }
  .writing-item + .writing-item { margin-top: clamp(2.5rem, 6vh, 4rem); }
  .writing-title {
    display: block;
    font-family: 'Inter Tight', system-ui, sans-serif;
    font-weight: 600;
    font-size: clamp(1.6rem, 3.2vw, 2.5rem);
    letter-spacing: -0.025em;
    line-height: 1.04;
    color: var(--fg);
    margin: 0 0 0.5rem 0;
    max-width: 24ch;
    text-wrap: balance;
  }
  .writing-item:hover .writing-title {
    text-decoration: underline;
    text-decoration-color: var(--acid);
    text-decoration-thickness: 0.06em;
    text-underline-offset: 0.12em;
  }
  .writing-meta {
    display: block;
    font-family: 'JetBrains Mono', monospace;
    font-size: 13px;
    color: var(--fgSoft);
  }
</style>
